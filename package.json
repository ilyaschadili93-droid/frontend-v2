{
  "name": "frontend-v2",
  "version": "0.0.0",
 "scripts": {
  "ng": "ng",
  "start": "serve -s dist/frontend --listen tcp://0.0.0.0:$PORT",
  "build": "ng build --configuration production",
  "watch": "ng build --watch --configuration development",
  "test": "ng test"
},
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@anam-ai/js-sdk": "^4.20.0",
    "@angular/animations": "^21.2.18",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "~7.8.0",
    "serve": "^14.2.6",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "typescript": "~5.9.2"
  }
}
